/* se10 -- 이 저장소의 실습용 표준셀 라이브러리.
 *
 * **손으로 적은 파일이 아니다.**  `lab/se/mklib.py` 가 RC 모형 하나에서
 * 전부 계산해 낸다.  고치려면 그 파일의 모형을 고치고 다시 내라:
 *
 *     python3 lab/se/mklib.py
 *
 * 모형:  지연 = 0.69·R·(C자체 + C부하) + 0.5·입력천이,  R = R단위/d,
 *        C자체 = d·p·C단위,  Cin = d·g·C단위
 * 상수:  R단위 = 8000 Ω,  C단위 = 2 fF
 * 그래서: FO4 = 55.2 ps  ->  180 nm 언저리 -> VDD 1.8 V
 * 자리:   0.66 × 5.04 µm (강의 화면의 LEF SITE 그대로)
 *
 * 진짜 공정이 아니다.  흐름이 도는 것을 보이는 데 필요한 만큼만 있다.
 */
library (se10) {
  technology (cmos);
  delay_model            : table_lookup;
  time_unit              : "1ns";
  voltage_unit           : "1V";
  current_unit           : "1mA";
  capacitive_load_unit   (1, pf);
  pulling_resistance_unit: "1kohm";
  leakage_power_unit     : "1nW";

  nom_voltage     : 1.8;
  nom_temperature : 25.0;
  nom_process     : 1.0;

  default_input_pin_cap  : 0.002;
  default_output_pin_cap : 0.0;
  default_inout_pin_cap  : 0.0;
  default_fanout_load    : 1.0;
  default_max_transition : 0.64;

  lu_table_template (dly) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.001, 0.004, 0.016, 0.064");
  }
  lu_table_template (con) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.01, 0.04, 0.16, 0.64");
  }
  cell (INVX1) {
    area : 6.6528;   /* 2 자리 */
    pin (A) { direction : input; capacitance : 0.00200; }
    pin (Y) { direction : output; function : "!A";
      max_capacitance : 0.0640;
      timing () { related_pin : "A"; timing_sense : negative_unate;
        cell_rise (dly) { values ( \
            "0.02156, 0.03812, 0.10436, 0.36932", \
            "0.03656, 0.05312, 0.11936, 0.38432", \
            "0.09656, 0.11312, 0.17936, 0.44432", \
            "0.33656, 0.35312, 0.41936, 0.68432"); }
        cell_fall (dly) { values ( \
            "0.02156, 0.03812, 0.10436, 0.36932", \
            "0.03656, 0.05312, 0.11936, 0.38432", \
            "0.09656, 0.11312, 0.17936, 0.44432", \
            "0.33656, 0.35312, 0.41936, 0.68432"); }
        rise_transition (dly) { values ( \
            "0.05280, 0.10560, 0.31680, 1.16160", \
