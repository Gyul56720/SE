[Unit]
Description=SE Discord Agent Bot (Gemini + Claude CLI + git sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/SE
EnvironmentFile=/home/ubuntu/SE/.env
ExecStart=/usr/bin/python3 /home/ubuntu/SE/discord_bot_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
