# === 이미 연동되어 있다고 한 Gemini 키를 여기 그대로 붙여넣으면 됨 ===
GEMINI_API_KEY=your_existing_gemini_key_here

# 분석/정리 단계 기본 모델. 무료 티어 한도와 모델명은 자주 바뀌므로
# https://ai.google.dev/gemini-api/docs/models 에서 현재 가용한 이름으로 확인 후 교체할 것.
GEMINI_MODEL=gemini-2.5-flash

# --- 선택: Q&A 레이어(qa_setup.py)에서 근거 요약용으로 Groq를 쓰고 싶을 때만 채움 ---
# 없으면 자동으로 GEMINI_MODEL 하나로만 동작함
GROQ_API_KEY=

# Semantic Scholar는 키 없이도 동작하지만(초당 1회 제한), 무료 키를 받으면 더 빨라짐
# 발급: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex "polite pool"(더 빠르고 안정적인 응답)을 위한 이메일. 필수는 아님.
OPENALEX_MAILTO=you@example.com

# 자료 정리 Agent가 마크다운을 실제로 써넣을 Obsidian vault 경로
OBSIDIAN_VAULT_PATH=/path/to/your/ObsidianVault/PaperResearch
