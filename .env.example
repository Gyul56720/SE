# === 이미 연동되어 있다고 한 Gemini 키를 여기 그대로 붙여넣으면 됨 ===
GEMINI_API_KEY=your_existing_gemini_key_here

# 선택: 위 키가 429(무료 티어 일일/분당 쿼터 초과)로 완전히 막히면 자동으로 이 키로
# 전환해서 재시도한다. 비워두면 기존처럼 기본 키 하나만 쓰다가 쿼터 초과 시 그냥 실패한다.
# discord_bot_server.py의 관리(admin) 채널 에이전트가 이 키를 전용으로 쓴다(공개 채널의
# GEMINI_API_KEY와 쿼터를 분리하기 위함) -- 채워두지 않으면 admin 채널 봇이 시작 실패한다.
GEMINI_API_KEY_FALLBACK=

# 분석/정리 단계 기본 모델. 무료 티어 한도와 모델명은 자주 바뀌므로
# https://ai.google.dev/gemini-api/docs/models 에서 현재 가용한 이름으로 확인 후 교체할 것.
GEMINI_MODEL=gemini-2.5-flash

# --- 선택: Q&A 레이어(qa_setup.py)에서 근거 요약용으로 Groq를 쓰고 싶을 때만 채움 ---
# 없으면 자동으로 GEMINI_MODEL 하나로만 동작함
GROQ_API_KEY=

# Semantic Scholar는 키 없이도 동작하지만(초당 1회 제한), 무료 키를 받으면 더 빨라짐
# 발급: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex "polite pool"(더 빠르고 안정적인 응답)을 위한 이메일. 필수는 아님.
OPENALEX_MAILTO=you@example.com

# Unpaywall API 식별용 이메일 (로그인 아님, DOI로 합법 오픈액세스 사본 조회에 필요).
# 비워두면 위 OPENALEX_MAILTO를 그대로 재사용함.
UNPAYWALL_EMAIL=

# 자료 정리 Agent가 마크다운을 실제로 써넣을 Obsidian vault 경로
OBSIDIAN_VAULT_PATH=/path/to/your/ObsidianVault/PaperResearch

# --- Discord 봇 연동 (선택) ---
# https://discord.com/developers/applications 에서 발급. 절대 커밋/채팅에 노출 금지 --
# 노출됐다면 Bot 탭 -> Reset Token으로 즉시 재발급할 것.
DISCORD_BOT_TOKEN=
# 봇에게 말 걸 수 있는 디스코드 유저 ID 화이트리스트, 콤마 구분(예: 111111111111111111,222...)
DISCORD_ALLOWED_USER_IDS=
# 관리 채널 ID (화이트리스트 적용, Gemini+LangGraph 에이전트가 run_shell 전권으로 응답)
DISCORD_CHANNEL_ID=
# 공개 채널 ID (화이트리스트 없음 -- 이 채널을 보는 누구나 봇에게 말 걸 수 있음, main_public.py 참고)
DISCORD_PUBLIC_CHANNEL_ID=
# 관리/공개 채널 각각의 Gemini 모델명 (기본값 gemini-3.5-flash-lite)
DISCORD_ADMIN_MODEL=
DISCORD_PUBLIC_MODEL=
# claude CLI 인증용 (`claude setup-token`으로 발급). Claude 토큰 소진 시 admin은 자동으로
# Gemini+LangGraph(GEMINI_API_KEY_FALLBACK)로 대체 동작하므로 없어도 봇 자체는 돌아간다.
CLAUDE_CODE_OAUTH_TOKEN=

# --- DeepSeek (선택, 수학 추론 성능 비교/대체 백본용) ---
# 발급: https://platform.deepseek.com/ -> API keys
DEEPSEEK_API_KEY=

# --- Ollama (선택, 로컬/자체 호스팅 완전 무료 백본) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─────────────────────────────────────────────────────────────────────────────
# Claude API. novel/drive.py 의 anthropic_llm() 이 쓴다 -- 소설의 author(director)
# 역할만 여기로 보내고 actor/narrator 는 Gemini 로 둔다. director 는 호출 6회 중 1회이고
# 출력이 300 토큰 남짓인데 플롯의 재미는 전부 거기서 갈리기 때문이다.
#
# 없어도 된다. 그러면 drive_novel 에 llm 을 넘기지 않으면 되고, 전부 Gemini 로 돈다.
# 발급: https://console.anthropic.com/settings/keys  (sk-ant- 로 시작)
ANTHROPIC_API_KEY=
# identity-linked 키(사용자 계정에 묶인 키)를 쓰면 워크스페이스 id 를 함께 보내야 한다.
# 400 anthropic-workspace-id is required ... 가 나오면 이것을 채워라.
# Console > Settings > Workspaces 에서 wrkspc_ 로 시작하는 id 를 복사한다.
# 워크스페이스 전용 API 키를 새로 발급받으면 이 값은 필요 없다.
ANTHROPIC_WORKSPACE_ID=
