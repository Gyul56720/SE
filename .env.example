# === Gemini ===
# 봇·오케스트레이터·소설·mathdrift 전부 이 키로 돈다. 한도는 프로젝트 단위라, 다른
# 프로젝트의 키를 FALLBACK 에 더하는 것만이 한도를 늘리는 길이다(같은 프로젝트에서 키만
# 여러 개 만들면 한도는 그대로다).
GEMINI_API_KEY=your_existing_gemini_key_here
# admin 채널 에이전트가 전용으로 쓴다(공개 채널과 쿼터 분리). 비우면 admin 봇이 시작 실패한다.
GEMINI_API_KEY_FALLBACK=
# 더 있으면 FALLBACK2, FALLBACK3 ... FALLBACK8 로 이어 붙인다. orchestrator/llm_pool.py 가 자동으로 잡는다.
# GEMINI_API_KEY_FALLBACK2=

# === Discord 봇 ===
# https://discord.com/developers/applications 에서 발급. 절대 커밋/채팅에 노출 금지 --
# 노출됐다면 Bot 탭 -> Reset Token 으로 즉시 재발급할 것.
DISCORD_BOT_TOKEN=
# 봇에게 말 걸 수 있는 유저 ID 화이트리스트, 콤마 구분
DISCORD_ALLOWED_USER_IDS=
# 이 서버(길드)에서 온 것만 받는다. **비우면 길드를 안 가린다**(채널 id 로만 거른다).
# 공개 채널에는 사용자 화이트리스트가 없어서 경계가 '그 채널인가' 하나뿐인데,
# 이것을 넣으면 둘이 된다.
#
# 이 값은 **디스코드에 물어서 확인했다**(2026-09-09):
#     python3 novel/discord_check.py --id 1547142075261132864
#     -> 채널이 아니라 길드(서버)다 -- '햄쌤'
# 그 사이 이 값을 채널 자리로 옮겼다가 되돌렸다. **눈으로는 못 가린다** -- 길드와
# 채널이 같은 꼴의 수라, 어디에 넣어도 오류가 안 나고 그냥 안 맞을 뿐이다.
# 물어보는 데 한 번이면 되므로 넣기 전에 물어본다.
DISCORD_GUILD_ID=1547142075261132864
# 관리 채널 (화이트리스트 적용, run_shell 전권)
DISCORD_CHANNEL_ID=
# 공개 채널 (화이트리스트 없음 -- main_public.py)
DISCORD_PUBLIC_CHANNEL_ID=
# 공개 채널을 더 두려면 _2 · _3 ... _9 로 잇는다. 한 칸에 쉼표로 여러 개도 된다.
# **여기에는 채널 id 만 넣는다.** 길드 id 를 넣으면 그 칸이 통째로 헛것이 된다 --
# 오류도 안 나고 그냥 안 맞는다. 넣기 전에 물어봐라:
#     python3 novel/discord_check.py --id <넣으려는 값>
#
# 아래 값은 **아직 안 물어본 것이다**(2026-09-09). 스노플레이크를 풀어 보니 길드
# '햄쌤'(1547142075261132864)보다 **427ms 뒤**에 만들어졌다 -- 서버를 만들 때 같이
# 생기는 기본 채널의 꼴이다. 그래도 그것은 정황이지 답이 아니다. 이 값이 세 자리를
# 오간 뒤에 배운 것이 그것이다: **길드와 채널은 눈으로 못 가린다.**
# 확인하면 이 문단을 '물어서 확인했다' 로 바꾼다.
DISCORD_PUBLIC_CHANNEL_ID_2=1547142077052362824
# se-log-streamer.service 가 서비스 로그를 중계할 채널. log_streamer.py 는 이것이 없으면 시작 못 한다.
DISCORD_LOG_CHANNEL_ID=
# 소설/mathdrift 런이 끝났을 때 알림을 보낼 웹훅 (novel/overnight.py · deliver.py). 없으면 안 보낸다.
DISCORD_WEBHOOK_URL=
# 관리/공개 채널 각각의 Gemini 모델명 (기본값은 코드가 정한다)
DISCORD_ADMIN_MODEL=
DISCORD_PUBLIC_MODEL=
# claude CLI 인증 (`claude setup-token`). Claude 토큰이 소진되면 admin 은 Gemini 로 대체 동작한다.
CLAUDE_CODE_OAUTH_TOKEN=

# === 법제처 OPEN API (law/) ===
# law/fetch.py 가 조문 원장(law/corpus/)을 채울 때 쓴다. 무료, 한 번만 발급:
#   open.law.go.kr 로그인 -> 'OPEN API 신청' -> 'API인증키관리' -> 현재 API인증키(OC)
# 없으면 law/gate.py 의 인용 대조 관문이 전부 '미검증' 으로 빠진다.
LAW_API_OC=

# === Claude API (novel/drive.py 의 디렉터 역할) ===
# 소설의 author(director) 만 여기로 보내고 actor/narrator 는 Gemini 로 둔다. 없어도 된다 --
# 그러면 전부 Gemini 로 돈다. 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# identity-linked 키를 쓰면 워크스페이스 id 가 필요하다 (400 anthropic-workspace-id is required).
ANTHROPIC_WORKSPACE_ID=

# 2026-09-08 정리에서 뺀 것: GROQ_API_KEY · SEMANTIC_SCHOLAR_API_KEY · OPENALEX_MAILTO ·
# UNPAYWALL_EMAIL · OBSIDIAN_VAULT_PATH · DEEPSEEK_API_KEY · OLLAMA_HOST · OLLAMA_MODEL · GEMINI_MODEL.
# 논문 리서치 파이프라인(2026-09-02 삭제)의 것이라 남은 코드 어디에서도 읽지 않는다.
